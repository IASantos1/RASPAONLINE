# API em modo exclusivamente demonstrativo
NODE_ENV=development
PORT=3000
DEMO_MODE=true

# Gere uma chave longa e aleatória para criar emissões DEMO
ADMIN_API_KEY=replace-with-a-long-random-secret

# PostgreSQL
DATABASE_URL=postgresql://raspaonline:password@localhost:5432/raspaonline
PGSSLMODE=disable
PG_POOL_MAX=10
